# Generated by reminder-calendar-control's Scripts/release.sh — edit the template there.
cask "rcc" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/scottisloud/homebrew-tap/releases/download/rcc-v#{version}/rcc.zip"
  name "rcc"
  desc "Calendar and Reminders for Claude Desktop, as a local MCP server"
  homepage "https://github.com/scottisloud/homebrew-tap"

  depends_on arch: :arm64
  depends_on macos: :tahoe

  # macOS ties the Calendar/Reminders grant to the binary's path, so rcc always runs from
  # one stable location, ~/Library/Application Support/reminder-calendar-control/bin/rcc.
  # The Caskroom copy only installs itself there (atomically; refuses downgrades and
  # signature changes), and `rcc` on PATH points at the stable copy. `brew upgrade` updates
  # it the same way, so Claude Desktop and the automation LaunchAgent pick it up.
  preflight_steps do
    run "rcc", args: ["install", "--quiet"], base: :staged_path, env: { "RCC_DISCLAIM_VERBOSE" => "0" },
        writable_paths: ["Library/Application Support/reminder-calendar-control",
                         "Library/Logs/reminder-calendar-control"],
        writable_base:  :home
    symlink "Library/Application Support/reminder-calendar-control/bin/rcc", "rcc-installed",
            source_base: :home, target_base: :staged_path
    # The curl installer's link to the same binary would otherwise block brew's own.
    remove "bin/rcc", base: :homebrew_prefix, symlink_target_contains: "reminder-calendar-control/bin/rcc"
  end

  binary "rcc-installed", target: "rcc"

  # Not `uninstall`: Homebrew runs those directives on every upgrade too, which would
  # unregister rcc from Claude Desktop each time. A plain `brew uninstall` leaves rcc
  # working; `--zap` removes it completely. Calendar and Reminders data is never touched.
  zap script: {
    executable: "#{Dir.home}/Library/Application Support/reminder-calendar-control/bin/rcc",
    args:       ["setup", "--uninstall", "--purge-state", "--remove-binary"],
  }

  caveats <<~EOS
    One more step, in Terminal (macOS will ask for Calendar and Reminders access):
      rcc setup

    `brew uninstall rcc` leaves rcc registered with Claude Desktop.
    To remove it completely: brew uninstall --zap rcc
  EOS
end
